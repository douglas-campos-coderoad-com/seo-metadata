# Template for the .env the deploy job writes to /opt/seo-metadata/.env on the VM.
# You never edit this file on the VM by hand — the deploy job regenerates it from
# GitHub secrets and variables on every run. It is here so you can see exactly
# which values the production stack consumes.

# ── Filled in by the deploy workflow ──────────────────────────────────────
# Artifact Registry path, e.g. europe-west1-docker.pkg.dev/my-project/seo-metadata
IMAGE_REPO=
# Per-component tags (commit SHAs). They are tracked separately so that
# deploying one side leaves the other on the image it is already running.
API_IMAGE_TAG=
WEB_IMAGE_TAG=

# ── Database (compose-internal, never exposed publicly) ───────────────────
POSTGRES_USER=incollect
POSTGRES_PASSWORD=
POSTGRES_DB=incollect

# ── App ───────────────────────────────────────────────────────────────────
# Public origin of the frontend; the API allows it through CORS
FRONTEND_URL=http://VM_EXTERNAL_IP
JWT_SECRET=

# ── AI providers (see backend/src/llm/) ───────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SERPER_API_KEY=

# ── PDF report export ─────────────────────────────────────────────────────
REPORT_RENDER_CONCURRENCY=2
REPORT_MAX_CODE_CHARS=20000
API_MEMORY_LIMIT=2g

# Database Configuration
DATABASE_URL=postgresql+asyncpg://incollect:incollect@postgres:5432/incollect_dev
DATABASE_TEST_URL=postgresql+asyncpg://incollect:incollect@postgres:5432/incollect_test

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
DEBUG=True

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Email Configuration (SMTP)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@incollect.local
SMTP_USE_TLS=false

# Admin User (for seeding)
ADMIN_EMAIL=admin@incollect.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Admin User

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI provider (see backend/src/llm/)
# Which provider answers every LLM call: gemini | anthropic
LLM_PROVIDER=gemini
# Optional provider-neutral overrides; they win over the provider-specific ones below
# LLM_MODEL=
# LLM_MODEL_FALLBACK=
# LLM_TEMPERATURE=0.2
# LLM_MAX_RETRIES=2

# AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.6-flash

# AI / Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5-20251001

# Web Search (Serper: https://serper.dev)
SERPER_API_KEY=your-serper-api-key

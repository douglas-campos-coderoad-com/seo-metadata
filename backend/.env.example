# Database
DATABASE_URL=postgresql+asyncpg://incollect:incollect@postgres:5432/incollect_dev

# App
DEBUG=True
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Auth (JWT)
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
SERPER_API_KEY=

# PDF report export (specs/005-pdf-report-export)
# Max simultaneous Chromium renders. Renders are memory-heavy; requests queue
# above this bound rather than exhausting the container.
REPORT_RENDER_CONCURRENCY=2
# Per-markup-block truncation threshold. A block longer than this is truncated
# and the report states visibly how many characters were omitted.
REPORT_MAX_CODE_CHARS=20000
